{
  "agents": {
    "overrides": {
      "sybase-inventory": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 50,
          "maxTimeMinutes": 20
        }
      },
      "dead-component": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 30,
          "maxTimeMinutes": 15
        }
      },
      "data-flow": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 40,
          "maxTimeMinutes": 15
        }
      },
      "integration-catalog": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 30,
          "maxTimeMinutes": 15
        }
      },
      "risk-assessment": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 40,
          "maxTimeMinutes": 20
        }
      },
      "spanner-schema": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 40,
          "maxTimeMinutes": 20
        }
      },
      "service-extraction": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 40,
          "maxTimeMinutes": 20
        }
      },
      "modernization": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 40,
          "maxTimeMinutes": 15
        }
      },
      "migration-orchestrator": {
        "enabled": true,
        "runConfig": {
          "maxTurns": 50,
          "maxTimeMinutes": 30
        }
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "sybase-migration/session-start",
            "type": "command",
            "command": "__HOOKS_DIR__/session-start.sh",
            "timeout": 5000,
            "description": "Detect Sybase migration project and inject phase/state context."
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace|edit|create_file",
        "hooks": [
          {
            "name": "sybase-migration/after-tool-report",
            "type": "command",
            "command": "__HOOKS_DIR__/after-tool-report.sh",
            "timeout": 5000,
            "description": "Update migration-state.json when a numbered report is written."
          },
          {
            "name": "sybase-migration/audit-log-tool",
            "type": "command",
            "command": "__HOOKS_DIR__/audit-log.sh",
            "timeout": 5000,
            "description": "Append the tool call to the migration audit log."
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "sybase-migration/before-agent",
            "type": "command",
            "command": "__HOOKS_DIR__/before-agent.sh",
            "timeout": 5000,
            "description": "Phase-gate validator: enforce report prerequisites."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "sybase-migration/audit-log-notification",
            "type": "command",
            "command": "__HOOKS_DIR__/audit-log.sh",
            "timeout": 5000,
            "description": "Mirror notifications into the migration audit log."
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "sybase-migration/pre-compress",
            "type": "command",
            "command": "__HOOKS_DIR__/pre-compress.sh",
            "timeout": 5000,
            "description": "Snapshot migration state before context compression."
          }
        ]
      }
    ]
  }
}
